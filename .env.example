# ─── Model ────────────────────────────────────────────────────────────────
# Public Supabase Auth values (Project Settings → API Keys). Never use a secret
# or service_role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "mock" is for explicit test/demo runs only. Production fails closed without a key.
MODEL_PROVIDER=openai

# OpenRouter free, open-weight Qwen vision endpoint. Availability can change.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
MODEL_NAME=qwen/qwen3.8-27b:free

# Optional direct Groq Free plan key. When present, it is tried before OpenRouter.
# No paid Groq plan is needed; check your account's exact limits first.
GROQ_API_KEY=

# Image turns use the same free Qwen vision model.
VISION_MODEL_NAME=qwen/qwen3.8-27b:free
MODEL_FALLBACK_NAME=google/gemma-4-31b-it:free

# Second free open-weight model, used for fallback and sampled offline QA.
AUDIT_MODEL_NAME=google/gemma-4-31b-it:free
AUDIT_SAMPLE_RATE=0.05
AUDIT_MAX_REQUESTS=3

# ─── Retrieval ────────────────────────────────────────────────────────────
# "memory" → ships with seed chunks so the UI renders citations today.
# "qdrant" → production vector store path, implemented in lib/rag/vectorstore.ts
RAG_PROVIDER=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cbse_10_live
QDRANT_AUTO_CREATE=false
QDRANT_VECTOR_SIZE=1024
HYBRID_SEARCH=true

# Free Workers AI BGE-M3 API; daily free allowance stops requests when exhausted.
# Create a Workers AI token; do not put real values in this file.
EMBEDDINGS_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional alternate OpenAI-compatible /v1/embeddings endpoint.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# Optional BGE-M3 lexical-weight endpoint. When blank, deterministic local
# lexical weights are used for sparse Qdrant search.
SPARSE_EMBEDDINGS_BASE_URL=
SPARSE_EMBEDDINGS_API_KEY=
SPARSE_EMBEDDINGS_MODEL=BAAI/bge-m3

# Cloudflare BGE reranker uses the same free Workers AI allocation.
# Set remote only if you have an OpenAI/Jina-style endpoint.
RERANKER_PROVIDER=cloudflare
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Disabled by default so corpus promotions cannot serve stale answers.
# memory works locally; redis uses an Upstash-compatible REST API.
CACHE_PROVIDER=none
CACHE_TTL_SECONDS=3600
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Optional MNLI service. POST receives {model, premise, hypotheses} and returns
# results with {label, score}. Leave blank for structural verification only.
NLI_BASE_URL=
NLI_API_KEY=
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_THRESHOLD=0.72

# Required for POST /api/ingest.
INGEST_API_KEY=replace-with-a-long-random-secret

# Extracted diagram crops are data/diagrams/<chunk_id>.webp by default.
DIAGRAM_DIR=data/diagrams
DIAGRAM_SIGNING_SECRET=replace-with-a-different-long-random-secret
DIAGRAM_URL_TTL_SECONDS=900

# Authoritative CBSE syllabus release. Retrieval resolves this first, then only
# admits content explicitly mapped to the resolved topic in this version.
SYLLABUS_VERSION=2026-27
